{
	"name": "ai-agent-harness",
	"version": "1.0.0",
	"description": "Deterministic RAG agent harness with typed contracts, guardrails, and eval harness",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"test:watch": "vitest",
		"eval": "tsx tests/eval/runner.ts",
		"eval:ci": "tsx tests/eval/runner.ts",
		"lint": "eslint src/ tests/",
		"format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
		"typecheck": "tsc --noEmit"
	},
	"packageManager": "pnpm@9.12.0+sha512.4abf725084d7bcbafbd728bfc7bee61f2f791f977fd87542b3579dcb23504d170d46337945e4c66485cd12d588a0c0e570ed9c477e7ccdd8507cf05f3f92eaca",
	"dependencies": {
		"@anthropic-ai/sdk": "^0.37.0",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/node": "^22.7.0",
		"@typescript-eslint/eslint-plugin": "^8.18.0",
		"@typescript-eslint/parser": "^8.18.0",
		"eslint": "^9.17.0",
		"globals": "^17.12.0",
		"prettier": "^3.4.2",
		"tsx": "^4.19.2",
		"typescript": "^5.6.3",
		"vitest": "^2.1.4"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
