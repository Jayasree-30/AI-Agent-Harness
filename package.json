{
	"name": "ai-agent-harness",
	"version": "1.0.0",
	"description": "Deterministic RAG agent harness with typed contracts, guardrails, and eval harness",
	"type": "module",
	"scripts": {
		"dev": "tsx src/ui/cli.ts",
		"build": "tsc",
		"test": "vitest run tests/unit tests/contracts",
		"test:watch": "vitest",
		"eval": "tsx tests/eval/runner.ts",
		"lint": "eslint src/ tests/",
		"typecheck": "tsc --noEmit"
	},
	"packageManager": "npm@10.9.0",
	"dependencies": {
		"@anthropic-ai/sdk": "^0.37.0",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/node": "^22.7.0",
		"@typescript-eslint/eslint-plugin": "^8.18.0",
		"@typescript-eslint/parser": "^8.18.0",
		"eslint": "^9.17.0",
		"globals": "^17.12.0",
		"tsx": "^4.19.2",
		"typescript": "^5.6.3",
		"vitest": "^2.1.4"
	},
	"engines": {
		"node": ">=20.0.0",
		"npm": ">=10.0.0"
	}
}
